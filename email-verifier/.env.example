APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000
# Per-IP requests per minute for the OTP endpoints.
RATE_LIMIT_PER_MINUTE=20

# Required in production: at least 32 random characters. HMAC key for OTP tokens.
OTP_SECRET=

# Leave SMTP_HOST empty in development to print OTP codes to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=NodeX <no-reply@example.com>
