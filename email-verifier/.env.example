APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000
# Per-IP requests per minute for the OTP endpoints.
RATE_LIMIT_PER_MINUTE=20

# Required in production: at least 32 random characters. HMAC key for OTP tokens.
OTP_SECRET=

# How codes are emailed. With neither Brevo nor SMTP set, codes are printed
# to the server log (development).

# Sender shown in the email (used by both Brevo and SMTP). With Brevo, this
# address must be a verified sender in your Brevo account.
SMTP_FROM=NodeX <no-reply@example.com>

# Option 1: Brevo's email API over HTTPS (works where SMTP ports are blocked,
# e.g. Render's free plan). Brevo → SMTP & API → API keys.
BREVO_API_KEY=

# Option 2: SMTP (e.g. Gmail with an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
