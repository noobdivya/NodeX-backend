APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000
# Per-IP requests per minute for the OTP endpoints.
RATE_LIMIT_PER_MINUTE=20

# Required in production: at least 32 random characters. HMAC key for OTP tokens.
OTP_SECRET=

# How codes are emailed. With neither Gmail nor SMTP set, codes are printed
# to the server log (development).

# Sender shown in the email (used by both Gmail API and SMTP).
SMTP_FROM=NodeX <no-reply@example.com>

# Option 1: Gmail API over HTTPS (works where SMTP ports are blocked, e.g.
# Render's free plan). Get the refresh token with: go run ./cmd/gmail-auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Option 2: SMTP (e.g. Gmail with an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
